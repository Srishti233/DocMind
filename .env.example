# Optional. Copy to .env: it is loaded automatically on every OS (real environment variables win).
# Ollama server settings (OLLAMA_MAX_LOADED_MODELS etc.) belong where `ollama serve` runs, not here.

LLM_MODEL=qwen2.5:3b-instruct   # use qwen2.5:1.5b-instruct if the 3B model is too slow
OLLAMA_URL=http://localhost:11434
DOCMIND_DATA_DIR=./data
EXTRACT_METADATA=true
RERANK_THRESHOLD=-3.0
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500
